tests/node_modules/
.claude/settings.local.json
.claude/

# The show's recorded audio is COMMITTED — RULING BI, which amends BA.  It was
# ignored here until the show track was split at the act break: one 134MB file
# could not be pushed at all (GitHub's hard limit is 100MB), and the halves are
# 69.4MB and 70.1MB.  The other two reasons BA gave — off a video, and a
# commercial recording on a repo with Pages on — were the owner's to overrule,
# and he did.  docs/AUDIO.md is the contract and carries the whole reasoning.
#
# Anything ELSE that lands in assets/audio/ is still an accident: the three
# files are named, nothing else is.
assets/audio/*
!assets/audio/README.md
!assets/audio/preshow.mp3
!assets/audio/act1.m4a
!assets/audio/act2.m4a

# the blocking generators' output (tools/blocking/*.py write it; tools/blocking-merge.py reads it) and their bytecode
tools/blocking/segments/
__pycache__/

# Video blocking capture (docs/superpowers/specs/2026-10-13-video-blocking-capture-design.md, RULING FX):
# the footage is Jack's, downloaded by him, NEVER committed; only video/INDEX.json (what the files are) is.
# tools/vision/cache/ holds decoded frames and per-frame detections, regenerable from the footage; the venv is his.
video/*
!video/INDEX.json
!video/README.md
tools/vision/cache/
tools/vision/.venv/
tools/vision/*.pt

# Johnny Tremain models fitted from CGTrader downloads (royalty-free / editorial: the model file may not be passed on).
# Local only; manifest.json marks them "local": true and the page tries them only on localhost.
assets/johnny-tremain/models/armchair.glb
assets/johnny-tremain/models/bench.glb
assets/johnny-tremain/models/kitchen-table.glb
assets/johnny-tremain/models/kitchen-benches.glb
assets/johnny-tremain/models/trestle-table.glb
assets/johnny-tremain/models/workbench.glb
assets/johnny-tremain/models/door-frame.glb
assets/johnny-tremain/models/window-flat.glb
assets/johnny-tremain/models/shop-doors.glb
